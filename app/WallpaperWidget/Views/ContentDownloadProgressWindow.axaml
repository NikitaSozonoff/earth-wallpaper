<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WallpaperWidget.Views.ContentDownloadProgressWindow"
        Title="Downloading wallpaper content"
        Icon="/Assets/avalonia-logo.ico"
        Width="480"
        Height="260"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#15181D">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="30">
        <StackPanel Grid.Row="0" Spacing="7">
            <TextBlock Text="DOWNLOADING CONTENT"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="#8FA1B8"
                       LetterSpacing="1.2" />
            <TextBlock x:Name="HeadingText"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Foreground="#F7F8FA"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ProgressBar x:Name="DownloadProgressBar"
                     Grid.Row="1"
                     Margin="0,24,0,0"
                     Height="9"
                     Minimum="0"
                     Maximum="100"
                     Value="0" />

        <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="AssetsText"
                       FontSize="12"
                       Foreground="#C4CBD4" />
            <TextBlock x:Name="PercentText"
                       Grid.Column="1"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#A9C8FF" />
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,14,0,0" Spacing="6">
            <TextBlock x:Name="BytesText"
                       FontSize="12"
                       Foreground="#98A3AF" />
            <TextBlock Text="You can continue using your computer. The collection will be activated only after every required image has been verified."
                       FontSize="11"
                       LineHeight="17"
                       Foreground="#77818E"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
