<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WallpaperWidget.Views.ContentPackWindow"
        Title="Choose wallpaper collection"
        Icon="/Assets/avalonia-logo.ico"
        Width="620"
        Height="450"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#15181D">
    <Grid RowDefinitions="Auto,*,Auto" Margin="30">
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="CHOOSE YOUR COLLECTION" FontSize="11" FontWeight="Bold" Foreground="#97A2B0" LetterSpacing="1.4" />
            <TextBlock Text="What should Earth Wallpaper download?" FontSize="25" FontWeight="SemiBold" Foreground="#F7F8FA" />
            <TextBlock Text="You can change this later in Widget Settings." FontSize="13" Foreground="#98A3AF" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,24,0,18">
            <Button Grid.Column="0" Padding="20" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Background="#22262D" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="14" Click="All_OnClick">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="ALL PLACES" FontSize="10" FontWeight="Bold" Foreground="#85AEEF" LetterSpacing="1.2" />
                    <TextBlock Grid.Row="1" Text="Complete collection" Margin="0,10,0,0" FontSize="19" FontWeight="SemiBold" Foreground="#F7F8FA" />
                    <TextBlock Grid.Row="2" Margin="0,10,0,0"
                               Text="Every published place, including visually subtle scenes chosen for their educational story."
                               FontSize="13" LineHeight="19" Foreground="#B8C0CA" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="3" Margin="0,16,0,0" Spacing="3">
                        <TextBlock x:Name="AllSizeText" Text="Checking download size…" FontSize="12" Foreground="#A7BDE1" />
                        <TextBlock Text="Maximum variety" FontSize="11" Foreground="#7F8995" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button Grid.Column="1" Padding="20" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Background="#22262D" BorderBrush="#6676A7FF" BorderThickness="1" CornerRadius="14" Click="Aesthetic_OnClick">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="VISUAL HIGHLIGHTS" FontSize="10" FontWeight="Bold" Foreground="#8CB2FF" LetterSpacing="1.2" />
                    <TextBlock Grid.Row="1" Text="Aesthetic selection" Margin="0,10,0,0" FontSize="19" FontWeight="SemiBold" Foreground="#F7F8FA" />
                    <TextBlock Grid.Row="2" Margin="0,10,0,0"
                               Text="Only images rated Cool for aesthetics. The strongest wallpaper compositions, even when the full collection contains more stories."
                               FontSize="13" LineHeight="19" Foreground="#B8C0CA" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="3" Margin="0,16,0,0" Spacing="3">
                        <TextBlock x:Name="AestheticSizeText" Text="Checking download size…" FontSize="12" Foreground="#A7C4F5" />
                        <TextBlock Text="Strongest visuals" FontSize="11" Foreground="#8FA7CE" />
                    </StackPanel>
                </Grid>
            </Button>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="Changing collections keeps shared images in the local cache, so they are not downloaded twice."
                   FontSize="11" Foreground="#77818E" TextAlignment="Center" TextWrapping="Wrap" />
    </Grid>
</Window>
